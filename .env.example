# Copy to .env. Everything is optional: with no keys the swarm runs in simulation,
# and the claude-cli / codex-cli providers use whatever login those CLIs already have.

# Server
PORT=4317
SWARM_DB_PATH=./data/swarm.db
# Bind address. Keep 127.0.0.1 until the dashboard has authentication.
HOST=127.0.0.1

# API providers (production). Leave blank to use the CLI providers instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
META_API_KEY=
META_BASE_URL=

# Sources
GITHUB_TOKEN=
