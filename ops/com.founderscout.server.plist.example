<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the Founder Scout server running on a Mac, so the daily run starts by itself.
  1. Replace both /ABSOLUTE/PATH/TO/agentswarm with the folder this file is in.
  2. Copy the file to ~/Library/LaunchAgents/com.founderscout.server.plist
  3. launchctl load ~/Library/LaunchAgents/com.founderscout.server.plist
  To stop it: launchctl unload ~/Library/LaunchAgents/com.founderscout.server.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.founderscout.server</string>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/agentswarm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>pnpm start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/agentswarm/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/agentswarm/data/server.log</string>
</dict>
</plist>
